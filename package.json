{
  "name": "tilemaxx",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --import tsx server/index.ts --dev",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "node dist-server/index.js",
    "test": "npm run test:unit && npm run test:ui",
    "check": "tsc --noEmit",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
    "predev": "npm run prepare:ocr",
    "prebuild": "npm run prepare:ocr",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test:ui": "vitest run",
    "verify": "npm test && npm run build"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "libheif-js": "^1.23.5",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "prettier": "3.8.1",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^4.1.12"
  }
}
